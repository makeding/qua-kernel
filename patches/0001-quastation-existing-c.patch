From 1f0db68cf6d7123d75afe2d2dc33dd777922df82 Mon Sep 17 00:00:00 2001
From: Qua Kernel Maintainers <maintainers@localhost>
Date: Fri, 20 Nov 2026 19:22:05 +0900
Subject: [PATCH] kernel: apply Qua changes to existing C sources

---
 arch/arm64/kernel/cpu_ops.c                |  6 ++
 drivers/gpio/gpio-rtd.c                    | 32 ++++---
 drivers/gpu/drm/panfrost/panfrost_gem.c    |  1 +
 drivers/gpu/drm/panfrost/panfrost_mmu.c    | 17 +++-
 drivers/mmc/host/dw_mmc.c                  | 98 ++++++++++++++++++++--
 drivers/net/wireless/realtek/rtlwifi/pci.c |  7 ++
 drivers/usb/dwc2/drd.c                     |  4 +
 drivers/usb/dwc2/params.c                  | 10 ++-
 drivers/usb/dwc3/dwc3-rtk.c                | 49 ++++++++++-
 drivers/watchdog/rtd119x_wdt.c             | 34 +++++++-
 10 files changed, 233 insertions(+), 25 deletions(-)

diff --git a/arch/arm64/kernel/cpu_ops.c b/arch/arm64/kernel/cpu_ops.c
index e133011..98f6474 100644
--- a/arch/arm64/kernel/cpu_ops.c
+++ b/arch/arm64/kernel/cpu_ops.c
@@ -15,6 +15,9 @@
 #include <asm/smp_plat.h>
 
 extern const struct cpu_operations smp_spin_table_ops;
+#ifdef CONFIG_ARM64_RTD129X_SPIN_TABLE
+extern const struct cpu_operations rtd129x_spin_table_ops;
+#endif
 #ifdef CONFIG_ARM64_ACPI_PARKING_PROTOCOL
 extern const struct cpu_operations acpi_parking_protocol_ops;
 #endif
@@ -24,6 +27,9 @@ static const struct cpu_operations *cpu_ops[NR_CPUS] __ro_after_init;
 
 static const struct cpu_operations *const dt_supported_cpu_ops[] __initconst = {
 	&smp_spin_table_ops,
+#ifdef CONFIG_ARM64_RTD129X_SPIN_TABLE
+	&rtd129x_spin_table_ops,
+#endif
 	&cpu_psci_ops,
 	NULL,
 };
diff --git a/drivers/gpio/gpio-rtd.c b/drivers/gpio/gpio-rtd.c
index d46b40d..2bd952e 100644
--- a/drivers/gpio/gpio-rtd.c
+++ b/drivers/gpio/gpio-rtd.c
@@ -527,12 +527,17 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	struct gpio_irq_chip *irq_chip;
 	struct rtd_gpio *data;
+	bool gpio_only;
 	int ret;
 
 	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
 	if (!data)
 		return -ENOMEM;
 
+	gpio_only = device_property_read_bool(dev, "realtek,gpio-only");
+	if (gpio_only)
+		goto skip_irqs;
+
 	ret = platform_get_irq(pdev, 0);
 	if (ret < 0)
 		return ret;
@@ -543,6 +548,7 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 		return ret;
 	data->irqs[1] = ret;
 
+skip_irqs:
 	data->info = device_get_match_data(dev);
 	if (!data->info)
 		return -EINVAL;
@@ -553,9 +559,11 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 	if (IS_ERR(data->base))
 		return PTR_ERR(data->base);
 
-	data->irq_base = devm_platform_ioremap_resource(pdev, 1);
-	if (IS_ERR(data->irq_base))
-		return PTR_ERR(data->irq_base);
+	if (!gpio_only) {
+		data->irq_base = devm_platform_ioremap_resource(pdev, 1);
+		if (IS_ERR(data->irq_base))
+			return PTR_ERR(data->irq_base);
+	}
 
 	data->gpio_chip.label = dev_name(dev);
 	data->gpio_chip.base = -1;
@@ -570,15 +578,17 @@ static int rtd_gpio_probe(struct platform_device *pdev)
 	data->gpio_chip.set_config = rtd_gpio_set_config;
 	data->gpio_chip.parent = dev;
 
-	irq_chip = &data->gpio_chip.irq;
-	irq_chip->handler = handle_bad_irq;
-	irq_chip->default_type = IRQ_TYPE_NONE;
-	irq_chip->parent_handler = rtd_gpio_irq_handle;
-	irq_chip->parent_handler_data = data;
-	irq_chip->num_parents = 2;
-	irq_chip->parents = data->irqs;
+	if (!gpio_only) {
+		irq_chip = &data->gpio_chip.irq;
+		irq_chip->handler = handle_bad_irq;
+		irq_chip->default_type = IRQ_TYPE_NONE;
+		irq_chip->parent_handler = rtd_gpio_irq_handle;
+		irq_chip->parent_handler_data = data;
+		irq_chip->num_parents = 2;
+		irq_chip->parents = data->irqs;
 
-	gpio_irq_chip_set_chip(irq_chip, &rtd_gpio_irq_chip);
+		gpio_irq_chip_set_chip(irq_chip, &rtd_gpio_irq_chip);
+	}
 
 	return devm_gpiochip_add_data(dev, &data->gpio_chip, data);
 }
diff --git a/drivers/gpu/drm/panfrost/panfrost_gem.c b/drivers/gpu/drm/panfrost/panfrost_gem.c
index 3a7fce4..d7c46de 100644
--- a/drivers/gpu/drm/panfrost/panfrost_gem.c
+++ b/drivers/gpu/drm/panfrost/panfrost_gem.c
@@ -488,6 +488,7 @@ panfrost_gem_create(struct drm_device *dev, size_t size, u32 flags)
 	if (IS_ERR(shmem))
 		return ERR_CAST(shmem);
 
+	mapping_set_gfp_mask(shmem->base.filp->f_mapping, GFP_KERNEL | GFP_DMA | __GFP_RETRY_MAYFAIL | __GFP_NOWARN);
 	bo = to_panfrost_bo(&shmem->base);
 	bo->noexec = !!(flags & PANFROST_BO_NOEXEC);
